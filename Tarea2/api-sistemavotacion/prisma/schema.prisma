generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Encuesta {
  id       Int      @id @default(autoincrement())
  pregunta String
  opciones Opcion[]
}

model Opcion {
  id         Int      @id @default(autoincrement())
  name       String
  votos      Int      @default(0)
  encuestaId Int
  encuesta   Encuesta @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
}